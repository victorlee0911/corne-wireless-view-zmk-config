#include <behaviors/num_word.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    behaviors {
        tlhm: timerless_lhr_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35>;
            hold-trigger-on-release;
        };

        trhm: timerless_rhr_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29>;
            hold-trigger-on-release;
        };

        lhm: left_homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-unless-interrupted";
            tapping-term-ms = <100>;                        // <---[[produces tap if held longer than tapping-term-ms]]
            quick-tap-ms = <200>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35>;
        };

        rhm: right_homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-unless-interrupted";
            tapping-term-ms = <100>;                        // <---[[produces tap if held longer than tapping-term-ms]]
            quick-tap-ms = <200>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29>;
        };

        bhm: balanced_homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;    // <---[[moderate duration]]
            quick-tap-ms = <0>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;
        };
    };

    macros {
        windows_ss: window_ss {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LSHFT &kp LEFT_GUI>,
                <&macro_tap>,
                <&kp S>,
                <&macro_release>,
                <&kp LSHFT &kp LEFT_GUI>;
        };

        clh: combo_layer_hybrid {
            compatible = "zmk,behavior-macro-two-param";
            #binding-cells = <2>;
            bindings =
                <&macro_param_1to1>,
                <&macro_press>,
                <&mo MACRO_PLACEHOLDER &macro_param_2to1>,
                <&macro_tap>,
                <&kp MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_param_1to1>,
                <&macro_release>,
                <&mo MACRO_PLACEHOLDER>;
        };
    };

    combos {
        compatible = "zmk,combos";

        l_grave {
            bindings = <&clh 1 GRAVE>;
            key-positions = <1 38>;
        };

        l_lessthan {
            bindings = <&clh 1 LT>;
            key-positions = <2 38>;
        };

        l_greaterthan {
            bindings = <&clh 1 GT>;
            key-positions = <3 38>;
        };

        l_dquote {
            bindings = <&clh 1 DOUBLE_QUOTES>;
            key-positions = <4 38>;
        };

        l_percent {
            bindings = <&clh 1 PERCENT>;
            key-positions = <5 38>;
        };

        l_excl {
            bindings = <&clh 1 EXCL>;
            key-positions = <13 38>;
        };

        l_minus {
            bindings = <&clh 1 MINUS>;
            key-positions = <14 38>;
        };

        l_plus {
            bindings = <&clh 1 PLUS>;
            key-positions = <15 38>;
        };

        l_equal {
            bindings = <&clh 1 EQUAL>;
            key-positions = <16 38>;
        };

        l_hash {
            bindings = <&clh 1 POUND>;
            key-positions = <17 38>;
        };

        l_caret {
            bindings = <&clh 1 CARET>;
            key-positions = <25 38>;
        };

        l_slash {
            bindings = <&clh 1 SLASH>;
            key-positions = <26 38>;
        };

        l_star {
            bindings = <&clh 1 STAR>;
            key-positions = <27 38>;
        };

        l_backslash {
            bindings = <&clh 1 BACKSLASH>;
            key-positions = <28 38>;
        };

        l_at {
            bindings = <&clh 1 AT>;
            key-positions = <38 29>;
        };

        r_tilde {
            bindings = <&clh 2 TILDE>;
            key-positions = <6 39>;
        };

        l_lbkt {
            bindings = <&clh 2 LBKT>;
            key-positions = <8 39>;
        };

        r_rbkt {
            bindings = <&clh 2 RBKT>;
            key-positions = <9 39>;
        };

        r_pipe {
            bindings = <&clh 2 PIPE>;
            key-positions = <18 39>;
        };

        r_colon {
            bindings = <&clh 2 COLON>;
            key-positions = <19 39>;
        };

        l_lparen {
            bindings = <&clh 2 LEFT_PARENTHESIS>;
            key-positions = <20 39>;
        };

        r_rparen {
            bindings = <&clh 2 RIGHT_PARENTHESIS>;
            key-positions = <21 39>;
        };

        r_amps {
            bindings = <&clh 2 AMPS>;
            key-positions = <30 39>;
        };

        r_dollar {
            bindings = <&clh 2 DOLLAR>;
            key-positions = <31 39>;
        };

        r_lbrace {
            bindings = <&clh 2 LEFT_BRACE>;
            key-positions = <32 39>;
        };

        r_rbrace {
            bindings = <&clh 2 RIGHT_BRACE>;
            key-positions = <39 33>;
        };

        r_apos {
            bindings = <&clh 2 APOS>;
            key-positions = <7 39>;
        };

        n0 {
            bindings = <&clh 3 N0>;
            key-positions = <40 23>;
        };

        n1 {
            bindings = <&clh 3 NUMBER_1>;
            key-positions = <31 23>;
        };

        n2 {
            bindings = <&clh 3 NUMBER_2>;
            key-positions = <32 23>;
        };

        n3 {
            bindings = <&clh 3 NUMBER_3>;
            key-positions = <33 23>;
        };

        n4 {
            bindings = <&clh 3 NUMBER_4>;
            key-positions = <19 23>;
        };

        n5 {
            bindings = <&clh 3 N5>;
            key-positions = <20 23>;
        };

        n6 {
            bindings = <&clh 3 NUMBER_6>;
            key-positions = <21 23>;
        };

        n7 {
            bindings = <&clh 3 N7>;
            key-positions = <7 23>;
        };

        n8 {
            bindings = <&clh 3 N8>;
            key-positions = <8 23>;
        };

        n9 {
            bindings = <&clh 3 N9>;
            key-positions = <9 23>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            display-name = "Base";
            bindings = <
&kp ESCAPE  &kp Q         &kp W         &kp E           &kp R          &kp T    &kp Y  &kp U          &kp I           &kp O         &kp P            &kp DEL
&mo 4       &tlhm LGUI A  &tlhm LALT S  &tlhm RSHIFT D  &tlhm LCTRL F  &kp G    &kp H  &trhm RCTRL J  &trhm RSHIFT K  &trhm RALT L  &trhm RGUI SEMI  &kp ENTER
&kp LCTRL   &kp Z         &kp X         &kp C           &kp V          &kp B    &kp N  &kp M          &kp COMMA       &kp DOT       &kp FSLH         &kp UNDER
                                        &kp TAB         &kp LSHIFT     &mo 1    &mo 2  &lt 3 SPACE    &kp BACKSPACE
            >;
        };

        symbol_left {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BKSP |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            display-name = "Raise";
            bindings = <
&trans  &kp GRAVE  &kp LT     &kp GT    &kp DQT    &kp PRCNT    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp EXCL   &kp MINUS  &kp PLUS  &kp EQUAL  &kp POUND    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp CARET  &kp FSLH   &kp STAR  &kp BSLH   &kp AT       &trans  &trans  &trans  &trans  &trans  &trans
                              &trans    &trans     &trans       &trans  &trans  &trans
            >;
        };

        symbol_right {
            display-name = "Raise";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &kp TILDE  &kp APOS   &kp LBKT  &kp RBKT  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &kp PIPE   &kp COLON  &kp LPAR  &kp RPAR  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &kp AMPS   &kp DLLR   &kp LBRC  &kp RBRC  &trans  &trans
                        &trans  &trans  &trans    &trans     &trans     &trans
            >;
        };

        number {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BKSP |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            display-name = "Lower";
            bindings = <
&trans      &kp F9  &kp F10       &kp F11        &kp F12        &trans    &trans  &kp N7        &kp N8    &kp N9  &trans         &trans
&kp LSHIFT  &kp F5  &bhm LALT F6  &bhm LSHFT F7  &bhm LCTRL F8  &trans    &kp N0  &kp NUMBER_4  &kp N5    &kp N6  &kp RIGHT      &trans
&kp LCTRL   &kp F1  &kp F2        &kp F3         &kp F4         &trans    &trans  &kp N1        &kp N2    &kp N3  &kp BACKSPACE  &trans
                                  &kp LGUI       &kp LALT       &trans    &trans  &trans        &kp RALT
            >;
        };

        movement {
            bindings = <
&trans  &trans  &kp LG(MINUS)     &kp LG(PLUS)     &kp LS(LG(NUMBER_4))  &kp LS(LC(GRAVE))    &trans  &bt BT_SEL 0  &kp UP_ARROW   &bt BT_SEL 1  &trans  &trans
&trans  &trans  &trans            &trans           &trans                &trans               &trans  &kp LEFT      &kp DOWN       &kp RIGHT     &trans  &trans
&trans  &trans  &kp LC(CAPSLOCK)  &kp LS(LC(TAB))  &kp LC(TAB)           &trans               &trans  &kp LC(LEFT)  &kp LC(RIGHT)  &trans        &trans  &trans
                                  &trans           &trans                &trans               &trans  &windows_ss   &trans
            >;
        };
    };
};
